# Copy to .env, or run `npm run setup` to fill this in interactively.

# Gmail (read-only, IMAP). App password from https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Telegram bot from @BotFather. TELEGRAM_CHAT_ID is filled in by `npm run setup`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenRouter (optional). Leave the key empty to run without AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LLM_DAILY_LIMIT=200
# 0 = never send PDF statement text to the model
LLM_PDF=1

# Dashboard
PORT=8787
# 1 = allow other devices on your Wi-Fi (they need ?token=ACCESS_TOKEN once)
LAN_ACCESS=0
ACCESS_TOKEN=

# Schedule (India time)
SYNC_MINUTES=15
DIGEST_TIME=09:00
